# ===================================================================
# AI MUSIC MOOD CLASSIFIER - ENVIRONMENT VARIABLES
# ===================================================================

# 1. Google Gemini AI API Configuration
# Get your free or paid API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Supported model: gemini-2.5-flash, gemini-1.5-flash, etc.
GEMINI_MODEL=gemini-2.5-flash

# 2. Supabase PostgreSQL Database Configuration
# Obtain from your project dashboard at: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# 3. Supabase Service Role Key (Optional / Privileged Server-Only Access)
# NEVER expose this key to client-side code (do NOT prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
